# Optional Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TARGET_PHONE_NUMBER=
# Optional JSON gauge feed
GAUGE_FEED_URL=
# Optional satellite tile provider URL (tiles are imagery only, not flood classification)
SATELLITE_TILE_URL=
# Optional operator authentication; enable only after adding users and a random 32+ character secret
AEGIS_AUTH_ENABLED=false
AEGIS_AUTH_SECRET=
AEGIS_USERS_JSON={}
AEGIS_ENABLE_LIVE_VOICE=false
# Network mode keeps operator actions disabled until authentication is configured.
AEGIS_LAN_MODE=true
# Same-origin app use needs no CORS; add exact trusted origins only for separate frontends.
AEGIS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Generate password hashes with: python scripts/hash_password.py
